{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Manifest",
  "description": "mod 能力清单",
  "type": "object",
  "properties": {
    "name": {
      "description": "mod 名，系统唯一",
      "type": "string",
      "minLength": 2,
      "maxLength": 63,
      "pattern": "^[a-z][a-z0-9_-]{1,62}$"
    },
    "version": {
      "description": "版本号，单调递增",
      "type": "integer",
      "format": "uint32",
      "minimum": 1,
      "maximum": 4294967295
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 500
    },
    "capabilities": {
      "description": "声明需要的宿主能力\n\n- 声明后才会出现在处理函数的 ctx 上。\n- intercept 形态的处理函数不注入任何 I/O 能力，\n比如：声明了 \"http\" 的 Mod，其 intercept 处理函数中依然没有 ctx.http",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Capability"
      },
      "default": [],
      "uniqueItems": true
    },
    "mcpServers": {
      "description": "mcp 服务声明\n- Stdio 服务\n- Streamable 服务\n- `mcp/<name>` 中的服务",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/McpServer"
      },
      "default": {},
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,62}$"
      }
    },
    "requests": {
      "description": "mod 暴露的 js 函数调用入口",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Request"
      },
      "default": {},
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,62}$"
      }
    },
    "events": {
      "description": "事件处理\n\n# on\n订阅宿主的事件，订阅后宿主会调用 mod 的 `handler` 中声明的 js 函数\n# emit\njs 向宿主发送事件的通道",
      "$ref": "#/$defs/Events",
      "default": {
        "on": {},
        "emit": {}
      }
    },
    "defs": {
      "description": "共享 schema 字典",
      "type": "object",
      "additionalProperties": {
        "type": [
          "object",
          "boolean"
        ]
      },
      "default": {},
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,62}$"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "name",
    "version"
  ],
  "$defs": {
    "Capability": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "http",
            "agent",
            "fs"
          ]
        },
        {
          "description": "对外状态，写入会广播给订阅方",
          "type": "string",
          "const": "state"
        },
        {
          "description": "私有键值存储，不广播",
          "type": "string",
          "const": "storage"
        }
      ]
    },
    "McpServer": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "url": {
          "type": "string",
          "minLength": 8,
          "pattern": "^[a-zA-Z][a-zA-Z0-9+.-]*:"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "command"
          ],
          "not": {
            "required": [
              "url"
            ]
          }
        },
        {
          "required": [
            "url"
          ],
          "not": {
            "required": [
              "command"
            ]
          }
        }
      ],
      "if": {
        "required": [
          "url"
        ]
      },
      "then": {
        "properties": {
          "args": {
            "maxItems": 0
          },
          "env": {
            "maxProperties": 0
          }
        }
      }
    },
    "Request": {
      "type": "object",
      "properties": {
        "handler": {
          "description": "js 导出的函数名",
          "type": "string",
          "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$"
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputSchema": {
          "description": "输入结构。宿主在调用边界校验",
          "type": [
            "object",
            "boolean",
            "null"
          ]
        },
        "outputSchema": {
          "description": "输出结构。宿主在调用边界校验。",
          "type": [
            "object",
            "boolean",
            "null"
          ]
        },
        "callableBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CallableBy"
          }
        },
        "timeoutMs": {
          "description": "本次调用的超时，毫秒",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 1,
          "maximum": 300000
        }
      },
      "additionalProperties": false,
      "required": [
        "handler"
      ]
    },
    "CallableBy": {
      "type": "string",
      "enum": [
        "agent",
        "ui"
      ]
    },
    "Events": {
      "type": "object",
      "properties": {
        "on": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EventSub"
          },
          "default": {},
          "propertyNames": {
            "pattern": "^core/"
          }
        },
        "emit": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/EmitDecl"
          },
          "default": {},
          "propertyNames": {
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,62}$"
          }
        }
      },
      "additionalProperties": false
    },
    "EventSub": {
      "type": "object",
      "properties": {
        "handler": {
          "description": "宿主调用的 js 函数名",
          "type": "string",
          "pattern": "^[a-zA-Z_$][a-zA-Z0-9_$]*$"
        },
        "timeoutMs": {
          "description": "本订阅的单次时间预算，毫秒",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 1,
          "maximum": 60000
        }
      },
      "additionalProperties": false,
      "required": [
        "handler"
      ]
    },
    "EmitDecl": {
      "type": "object",
      "properties": {
        "retention": {
          "$ref": "#/$defs/Retention"
        },
        "eventKey": {
          "description": "持久化数据的事件名是完整名字（m_<mod_name>/<event_key>）",
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-zA-Z_][a-zA-Z0-9_-]{0,62}$",
          "minLength": 1
        },
        "payload": {
          "type": [
            "object",
            "boolean"
          ]
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "retention",
        "payload"
      ],
      "if": {
        "required": [
          "retention"
        ],
        "properties": {
          "retention": {
            "const": "journal"
          }
        }
      },
      "then": {
        "required": [
          "eventKey"
        ],
        "properties": {
          "eventKey": {
            "type": "string"
          }
        }
      }
    },
    "Retention": {
      "oneOf": [
        {
          "description": "需要持久化的事件和 payload",
          "type": "string",
          "const": "journal"
        },
        {
          "description": "只推给当前在线的订阅方，允许丢失",
          "type": "string",
          "const": "live"
        }
      ]
    }
  }
}
